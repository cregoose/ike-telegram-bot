generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  telegramId BigInt @unique

  username String?
  firstName String

  createdAt DateTime @default(now())

  stats UserStats[]
}

model UserStats {
  id Int @id @default(autoincrement())
  userId Int
  chatId BigInt

  totalPosts Int @default(0)
  postsWeek  Int @default(0)
  postsMonth Int @default(0)

  maxCharsWeek    Int @default(0)
  maxCharsMonth   Int @default(0)
  maxCharsAllTime Int @default(0)

  updatedAtWeek  DateTime @default(now())
  updatedAtMonth DateTime @default(now())

  isLeft Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  @@unique([userId, chatId])
}

model ChatSettings {
  chatId         BigInt  @id
  sendToPM       Boolean @default(false)
  autoDeleteTime Int     @default(0)       // Добавлено для автоудаления (в секундах)
  minChars       Int     @default(0)       // Добавлено для лимита символов
  minCharsAction String  @default("none")  // Добавлено для действия (например, "delete" или "warn")
}
model DailyActivity {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  userId    BigInt
  date      String   // Будем хранить дату в формате "YYYY-MM-DD"
  posts     Int      @default(0)
  chars     Int      @default(0)

  @@unique([chatId, userId, date]) // Уникальный индекс, чтобы не плодить дубликаты
}